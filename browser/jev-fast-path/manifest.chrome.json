{
  "manifest_version": 3,
  "name": "Computer Use Current Tab Evidence",
  "version": "0.1.0",
  "description": "Share bounded visible tab controls with the local Computer Use MCP after an explicit user action.",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "action": {
    "default_title": "Enable Computer Use evidence for this tab"
  },
  "background": {
    "service_worker": "background.js"
  }
}
